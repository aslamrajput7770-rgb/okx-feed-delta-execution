# Delta Exchange India - non-secret configuration.
#
# This file is committed, so it holds NO credentials. Supply the key and secret
# one of these ways instead, in order of preference:
#
#   1. Platform secrets. Add DELTA_API_KEY and DELTA_API_SECRET as secrets in
#      the platform settings. They are injected into every session
#      automatically, so a new session has to be told nothing, and the values
#      never touch the repository or its history.
#   2. An untracked file next to this one: cp delta.env delta.local.env, fill it
#      in; git ignores it.
#   3. Environment variables exported by hand.
#
# DeltaCredentials.from_env() reads DELTA_API_KEY / DELTA_API_SECRET. There is no
# constructor argument for the secret, deliberately.

DELTA_ENVIRONMENT=live

# The key is IP-locked. A request from any other address returns
# ip_not_whitelisted_for_api_key, and the error names the offending client_ip.
# This address is the one whitelisted against the key.
VPS_HOST=3.108.53.100
VPS_USER=ec2-user

# Resolved at runtime by resolve_perpetual(); never hardcode an id across
# environments.
#   live     id 27 -> BTCUSD perpetual, tick 0.5,   1 contract = 0.001 BTC
#   testnet  id 84 -> BTCUSD perpetual, tick 0.1,   1 contract = 0.001 BTC
#   testnet  id 27 -> expired March future,         1 contract = 1 BTC (1000x)
DELTA_VERIFIED_PRODUCT_ID=27
