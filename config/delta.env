# Delta Exchange India - credentials for this project.
#
# Committed at the owner's explicit instruction. The repository is private.
#
# These are LIVE trading credentials: the pair below authenticates against
# api.india.delta.exchange and can read the wallet (verified: 7 assets). They
# travelled through a chat log, so rotating them is advised once testing is
# complete. Access is currently narrowed by the IP whitelist below.

DELTA_ENVIRONMENT=live
DELTA_API_KEY=REPLACE_WITH_PLATFORM_SECRET
DELTA_API_SECRET=REPLACE_WITH_PLATFORM_SECRET

# The key is IP-locked. Requests from any other address return
# ip_not_whitelisted_for_api_key. This host is AWS ap-south-1, Mumbai.
VPS_HOST=3.108.53.100
VPS_USER=ec2-user

# Resolved at runtime by preflight; never hardcode an id across environments.
# live     id 27 -> BTCUSD perpetual, tick 0.5, 1 contract = 0.001 BTC
# testnet  id 84 -> BTCUSD perpetual, tick 0.1, 1 contract = 0.001 BTC
# testnet  id 27 -> expired March future, 1 contract = 1 BTC (1000x larger)
DELTA_VERIFIED_PRODUCT_ID=27
