# Secrets. Credentials live in the environment, never in the repo.
.env
.env.*
secrets.json

# Local credential files, see config/delta.env
config/delta.local.env
config/telegram.local.env
telegram.env
*.key
*.pem

# Runtime state: the persisted daily loss counter. Per-host, not per-repo.
state/

# Replay tapes, whether downloaded from OKX or recorded live from Delta.
tape*.txt
capture*.txt
*.capture
recordings/

# Local captures and generated reports.
reports/
*.log
tape_run.log

# A live capture holds a lock on its output so two writers cannot share it.
*.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
